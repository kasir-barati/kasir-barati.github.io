        "react-redux": "^8.1.3",
        "react-router-dom": "^6.30.4",
        "react-typed": "^1.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^3.1.0",
        "concurrently": "^9.2.1",
        "gh-pages": "^5.0.0",
