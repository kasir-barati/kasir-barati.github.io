        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-redux": "^9.3.1",
        "react-router": "^8.5.3",
        "react-typed": "^2.0.12"
    },
    "devDependencies": {
        "@types/node": "^24.19.4",
        "@types/react": "^19.3.3",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
